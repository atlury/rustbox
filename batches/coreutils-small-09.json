      "replacement": "*sleep_interval = tail_dtimespec_bound (s, errno);",
      "expected_after": "*sleep_interval = tail_dtimespec_bound (s, errno);",
      "reason": "Route tail's parsed double through a typed helper so C2Rust does not emit the generic signbit macro's unreachable f128 branch."
    },
    {
      "source": "src/tail.c",
      "engine": "exact",
      "expected_before": "  return true;\n}\n\nstatic void\nparse_options (int argc, char **argv,",
      "replacement": "  return true;\n}\n\nstatic inline double\ntail_dtimespec_bound (double c, int err)\n{\n  if (err == ERANGE && c == 0)\n    return __builtin_signbit (c) ? -DBL_TRUE_MIN : DBL_TRUE_MIN;\n\n  double phi = DBL_EPSILON / 2 * (1 + DBL_EPSILON);\n  return c + phi * c;\n}\n\nstatic void\nparse_options (int argc, char **argv,",
      "expected_after": "tail_dtimespec_bound (double c, int err)",
      "reason": "Specialize gnulib's exact dtimespec_bound algorithm to double, including negative-zero underflow, without generic signbit dispatch."
    },
