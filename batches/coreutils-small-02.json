{
  "schema": 1,
  "upstream": "GNU Coreutils 9.12",
  "name": "coreutils-small-02",
  "applets": [
    "arch",
    "echo",
    "hostname",
    "nice",
    "nproc",
    "readlink",
    "sleep",
    "sync",
    "uptime",
    "users"
  ],
  "output_regex": "/src/libsinglebin_(arch|echo|hostname|nice|nproc|readlink|sleep|sync|uptime|users)_",
  "expected_compile_commands": 10,
  "translation_variant": "normalized",
  "prepare_scaffold": true,
  "reachable_staticlib": "libcoreutils_small_02_normalized_reachable.a",
  "differential_harness": "coreutils_small_02_differential.py",
  "upstream_tests": [
    "tests/misc/arch.sh",
    "tests/misc/echo.sh",
    "tests/misc/sleep.sh",
    "tests/misc/sync.sh",
    "tests/df/sync.sh",
    "tests/nice/nice.sh",
    "tests/nice/nice-fail.sh",
    "tests/nproc/nproc-avail.sh",
    "tests/nproc/nproc-override.sh",
    "tests/nproc/nproc-positive.sh",
    "tests/nproc/nproc-quota.sh",
    "tests/nproc/nproc-quota-systemd.sh",
    "tests/readlink/readlink-fp-loop.sh",
    "tests/readlink/readlink-posix.sh",
    "tests/readlink/readlink-root.sh",
    "tests/help/help-version.sh",
    "tests/help/help-version-getopt.sh"
  ],
  "valgrind_cases": [
    {"applet": "arch", "arguments": [], "status": 0},
    {"applet": "echo", "arguments": ["hello"], "status": 0},
    {"applet": "hostname", "arguments": [], "status": 0},
    {"applet": "nice", "arguments": [], "status": 0},
    {"applet": "nproc", "arguments": [], "status": 0},
    {"applet": "readlink", "arguments": ["missing"], "status": 1},
    {"applet": "sleep", "arguments": ["0"], "status": 0},
    {"applet": "sync", "arguments": [], "status": 0},
    {"applet": "uptime", "arguments": ["missing"], "status": 1},
    {"applet": "users", "arguments": ["missing"], "status": 1}
  ],
  "c_normalization": [
    {
      "source": "src/sync.c",
      "semantic_patch": "normalization/coreutils/sync-bool-and.cocci",
      "expected_before": "ok &= sync_arg (mode, argv[optind]);",
      "expected_after": "ok = sync_arg(mode, argv[optind]) && ok;",
      "reason": "C2Rust rejects integer-to-bool casts generated for bool &= bool. Calling sync_arg first preserves eager RHS evaluation and the same boolean truth table."
    }
  ],
  "selection_policy": "The ten smallest remaining one-command applet slices with independent public entry points; shared canonical C libraries remain linked during the first hybrid substitution gate."
}
