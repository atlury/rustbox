{
  "schema": 1,
  "upstream": "GNU Coreutils 9.12",
  "name": "coreutils-small-06",
  "applets": [
    "cat",
    "dircolors",
    "fmt",
    "nl",
    "pinky",
    "realpath",
    "shuf",
    "tac",
    "timeout",
    "uniq"
  ],
  "output_regex": "/src/libsinglebin_(cat|dircolors|fmt|nl|pinky|realpath|shuf|tac|timeout|uniq)_",
  "expected_compile_commands": 13,
  "translation_variant": "normalized",
  "prepare_scaffold": true,
  "reachable_staticlib": "libcoreutils_small_06_normalized_reachable.a",
  "differential_harness": "coreutils_small_06_differential.py",
  "upstream_tests": [
    "tests/cat/cat-E.sh",
    "tests/cat/cat-buf.sh",
    "tests/cat/cat-distinct-err.sh",
    "tests/cat/cat-proc.sh",
    "tests/cat/cat-self.sh",
    "tests/cat/splice.sh",
    "tests/misc/dircolors.pl",
    "tests/fmt/base.pl",
    "tests/fmt/goal-option.sh",
    "tests/fmt/long-line.sh",
    "tests/fmt/non-space.sh",
    "tests/fmt/width.sh",
    "tests/nl/multibyte.sh",
    "tests/nl/multiple-files.sh",
    "tests/nl/nl.sh",
    "tests/misc/realpath.sh",
    "tests/shuf/shuf-reservoir.sh",
    "tests/shuf/shuf.sh",
    "tests/tac/tac-2-nonseekable.sh",
    "tests/tac/tac-continue.sh",
    "tests/tac/tac-locale.sh",
    "tests/tac/tac.pl",
    "tests/timeout/init-parent.sh",
    "tests/timeout/timeout-blocked.pl",
    "tests/timeout/timeout-group.sh",
    "tests/timeout/timeout-large-parameters.sh",
    "tests/timeout/timeout-parameters.sh",
    "tests/timeout/timeout.sh",
    "tests/uniq/uniq-c-width.sh",
    "tests/uniq/uniq-collate.sh",
    "tests/uniq/uniq-perf.sh",
    "tests/uniq/uniq.pl",
    "tests/help/help-version.sh",
    "tests/help/help-version-getopt.sh"
  ],
  "valgrind_cases": [
    {"applet": "cat", "arguments": [], "status": 0},
    {"applet": "dircolors", "arguments": ["-p"], "status": 0},
    {"applet": "fmt", "arguments": [], "status": 0},
    {"applet": "nl", "arguments": [], "status": 0},
    {"applet": "pinky", "arguments": [], "status": 0},
    {"applet": "realpath", "arguments": ["missing"], "status": 0},
    {"applet": "shuf", "arguments": ["-e"], "status": 0},
    {"applet": "tac", "arguments": [], "status": 0},
    {"applet": "timeout", "arguments": ["0", "/bin/true"], "status": 0},
    {"applet": "uniq", "arguments": [], "status": 0}
  ],
  "c_normalization": [
    {
      "source": "src/cat.c",
      "semantic_patch": "normalization/coreutils/bool-eager-and.cocci",
      "expected_before": "ok &= 0 < copy_cat_status;",
      "expected_after": "ok = 0 < copy_cat_status && ok;",
      "reason": "Preserve eager cat operation evaluation while avoiding C2Rust's integer-to-bool casts for bool &= bool."
    },
    {
      "source": "src/fmt.c",
      "semantic_patch": "normalization/coreutils/bool-eager-and.cocci",
      "expected_before": "ok &= fmt (stdin, file);",
      "expected_after": "ok = fmt",
      "expected_after_count": 3,
      "reason": "Preserve eager fmt evaluation and accumulate its Boolean status explicitly."
    },
    {
      "source": "src/nl.c",
      "engine": "exact",
      "expected_before": "ok &= nl_file (argv[optind]);",
      "replacement": "ok = nl_file (argv[optind]) && ok;",
      "expected_after": "ok = nl_file",
      "expected_after_count": 2,
      "reason": "Preserve eager nl_file evaluation and accumulate its Boolean status explicitly."
    },
    {
      "source": "src/realpath.c",
      "engine": "exact",
      "expected_before": "ok &= process_path (argv[optind], can_mode);",
      "replacement": "ok = process_path (argv[optind], can_mode) && ok;",
      "expected_after": "ok = process_path (argv[optind], can_mode) && ok;",
      "reason": "Preserve eager process_path evaluation and accumulate its Boolean status explicitly."
    },
    {
      "source": "src/relpath.c",
      "semantic_patch": "normalization/coreutils/bool-call-eager-or.cocci",
      "expected_before": "buf_err |= buffer_or_output (\"..\", &buf, &len);",
      "expected_after": "buf_err = buffer_or_output",
      "expected_after_count": 5,
      "reason": "Always emit every relative-path component while explicitly accumulating output errors."
    },
    {
      "source": "src/cat.c",
      "engine": "exact",
      "expected_before": "ckd_mul (&bufsize, insize, 4)",
      "replacement": "ckd_mul (&bufsize, insize, (idx_t) 4)",
      "expected_after": "ckd_mul (&bufsize, insize, (idx_t) 4)",
      "reason": "Make the small multiplier's exact idx_t destination width explicit."
    },
    {
      "source": "src/cat.c",
      "engine": "exact",
      "expected_before": "ckd_add (&bufsize, bufsize, LINE_COUNTER_BUF_LEN - 1)",
      "replacement": "ckd_add (&bufsize, bufsize, (idx_t) (LINE_COUNTER_BUF_LEN - 1))",
      "expected_after": "ckd_add (&bufsize, bufsize, (idx_t) (LINE_COUNTER_BUF_LEN - 1))",
      "reason": "Make the bounded line-counter allowance's exact idx_t width explicit."
    },
    {
      "source": "src/realpath.c",
      "engine": "exact",
      "expected_before": "ckd_mul (&size, strlen (can_relative_to), 2)",
      "replacement": "ckd_mul (&size, strlen (can_relative_to), (size_t) 2)",
      "expected_after": "ckd_mul (&size, strlen (can_relative_to), (size_t) 2)",
      "reason": "Make the relative-path size multiplier's size_t width explicit."
    },
    {
      "source": "src/realpath.c",
      "engine": "exact",
      "expected_before": "ckd_add (&size, size, 1)",
      "replacement": "ckd_add (&size, size, (size_t) 1)",
      "expected_after": "ckd_add (&size, size, (size_t) 1)",
      "reason": "Make the terminating-byte allowance's size_t width explicit."
    },
    {
      "source": "src/tac.c",
      "engine": "exact",
      "expected_before": "ok &= tac_file (file[i]);",
      "replacement": "ok = tac_file (file[i]) && ok;",
      "expected_after": "ok = tac_file (file[i]) && ok;",
      "reason": "Preserve eager tac_file evaluation while explicitly accumulating its Boolean status."
    },
    {
      "source": "src/shuf.c",
      "engine": "exact",
      "expected_before": "struct randint_source *randint_source;",
      "replacement": "struct randint_source *rand_source;",
      "expected_after": "struct randint_source *rand_source;",
      "reason": "Avoid a C2Rust type/value spelling collision by renaming a private pointer variable; ABI is unchanged."
    },
    {
      "source": "src/shuf.c",
      "engine": "exact",
      "expected_before": "randint_source = randint_all_new",
      "replacement": "rand_source = randint_all_new",
      "expected_after": "rand_source = randint_all_new",
      "reason": "Follow the private shuf pointer-variable rename at initialization."
    },
    {
      "source": "src/shuf.c",
      "engine": "exact",
      "expected_before": "if (! randint_source)",
      "replacement": "if (! rand_source)",
      "expected_after": "if (! rand_source)",
      "reason": "Follow the private shuf pointer-variable rename at its null check."
    },
    {
      "source": "src/shuf.c",
      "engine": "exact",
      "expected_before": "randint_source, &reservoir",
      "replacement": "rand_source, &reservoir",
      "expected_after": "rand_source, &reservoir",
      "reason": "Follow the private shuf pointer-variable rename in reservoir sampling."
    },
    {
      "source": "src/shuf.c",
      "engine": "exact",
      "expected_before": "randperm_new (randint_source,",
      "replacement": "randperm_new (rand_source,",
      "expected_after": "randperm_new (rand_source,",
      "reason": "Follow the private shuf pointer-variable rename in permutation generation."
    },
    {
      "source": "src/shuf.c",
      "engine": "exact",
      "expected_before": "write_random_numbers (randint_source,",
      "replacement": "write_random_numbers (rand_source,",
      "expected_after": "write_random_numbers (rand_source,",
      "reason": "Follow the private shuf pointer-variable rename in range output."
    },
    {
      "source": "src/shuf.c",
      "engine": "exact",
      "expected_before": "write_random_lines (randint_source,",
      "replacement": "write_random_lines (rand_source,",
      "expected_after": "write_random_lines (rand_source,",
      "reason": "Follow the private shuf pointer-variable rename in line output."
    },
    {
      "source": "src/shuf.c",
      "engine": "exact",
      "expected_before": "randint_all_free (randint_source)",
      "replacement": "randint_all_free (rand_source)",
      "expected_after": "randint_all_free (rand_source)",
      "reason": "Follow the private shuf pointer-variable rename at cleanup."
    },
    {
      "source": "src/timeout.c",
      "engine": "exact",
      "expected_before": "*x = dtimespec_bound (*x * multiplier, 0);",
      "replacement": "*x = timeout_dtimespec_bound (*x * multiplier, 0);",
      "expected_after": "*x = timeout_dtimespec_bound (*x * multiplier, 0);",
      "reason": "Route timeout's scaled double through a typed helper so C2Rust does not emit the type-generic signbit macro's unreachable f128 branch."
    },
    {
      "source": "src/timeout.c",
      "engine": "exact",
      "expected_before": "double s = dtimespec_bound (duration, errno);",
      "replacement": "double s = timeout_dtimespec_bound (duration, errno);",
      "expected_after": "double s = timeout_dtimespec_bound (duration, errno);",
      "reason": "Route timeout's parsed double through the same typed bound helper."
    },
    {
      "source": "src/timeout.c",
      "engine": "exact",
      "expected_before": "  exit (status);\n}\n\n/* Given a floating point value *X, and a suffix character, SUFFIX_CHAR,",
      "replacement": "  exit (status);\n}\n\nstatic inline double\ntimeout_dtimespec_bound (double c, int err)\n{\n  if (err == ERANGE && c == 0)\n    return __builtin_signbit (c) ? -DBL_TRUE_MIN : DBL_TRUE_MIN;\n\n  double phi = DBL_EPSILON / 2 * (1 + DBL_EPSILON);\n  return c + phi * c;\n}\n\n/* Given a floating point value *X, and a suffix character, SUFFIX_CHAR,",
      "expected_after": "timeout_dtimespec_bound (double c, int err)",
      "reason": "Specialize gnulib's exact dtimespec_bound algorithm to double, including negative-zero underflow, without the generic signbit dispatch that C2Rust cannot type-eliminate."
    },
    {
      "source": "src/uniq.c",
      "engine": "exact",
      "expected_before": "if (!DECIMAL_DIGIT_ACCUMULATE (skip_fields, optc - '0'))\n              skip_fields = IDX_MAX;",
      "replacement": "if (ckd_mul (&skip_fields, skip_fields, (idx_t) 10)\n                || ckd_add (&skip_fields, skip_fields,\n                            (idx_t) (optc - '0')))\n              skip_fields = IDX_MAX;",
      "expected_after": "ckd_mul (&skip_fields, skip_fields, (idx_t) 10)",
      "reason": "Expand the decimal-accumulation macro with explicit idx_t operands so C2Rust keeps both checked operations at the destination width."
    }
  ],
  "deferred_abi": [
    {
      "applets": ["printf", "seq"],
      "reason": "C2Rust 0.22.1 maps x86_64 GNU 80-bit long double to the f128 crate's incompatible IEEE binary128 representation. Differential tests caught zero-valued floating output; these applets require a typed C ABI bridge before translation can be accepted."
    }
  ],
  "selection_policy": "The next measured-smallest independent canonical archives after batch five, excluding SELinux and systemd support by project policy. Mkfifo and mknod are deferred until their non-SELinux canonical configurations are captured. Differential testing moved printf and seq to the shared long-double ABI queue; timeout and uniq are substituted. Id remains deferred because its canonical build includes SELinux support."
}
